# Local environment variables for cbl-backoffice.
HTTP_ADDR=:8020
METRICS_ADDR=:9220
PG_DSN=postgres://cbl:cbl@localhost:5432/backoffice?sslmode=disable
MIGRATIONS_DIR=./migrations
# Dev stand only: the HS256 key of operator tokens (at least 16 characters);
# the e2e mint utility signs tokens with the same secret.
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-please
